# Optional Environment Variables for Ziro Self-Contained Runtime
# By default, zero external database or configuration is required:
# - Market data: data/ziro_frozen_dataset.parquet (PyArrow Dataset)
# - Paper trading: data/paper_predictions.db (SQLite)

# Optional: Custom Paper Trading Database URL (defaults to sqlite:///data/paper_predictions.db)
# PAPER_TRADING_DB_URL=sqlite:///./data/paper_predictions.db

# Optional: Legacy PostgreSQL URL (used only by offline historical research scripts)
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dbname
